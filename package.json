{
  "name": "chatgpt-mint-skin",
  "version": "1.3.3",
  "description": "A local, non-invasive mint skin for the ChatGPT desktop app: wallpaper, chibi rail mascot and a state-aware Sol assistant.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "chatgpt",
    "electron",
    "skin",
    "theme",
    "cdp",
    "windows"
  ],
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup.ps1",
    "doctor": "node tools/doctor.mjs",
    "repair": "node tools/doctor.mjs --repair",
    "verify": "node tools/verify.mjs",
    "launch": "node tools/launch-skin.mjs",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/skin-stop.ps1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/pack.ps1"
  }
}
